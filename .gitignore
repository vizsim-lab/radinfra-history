# Pipeline working data: history files, snapshots, per-snapshot classifications.
# History files carry personal metadata (user names, uids) and must never be committed.
/data/
*.osh.pbf
*.osm.pbf

# Build output. Published on the `data` branch (scripts/publish_data.sh), not on
# main, so the repository does not grow by a tileset on every rebuild.
site/tiles/*.pmtiles
site/data/*_timeline.json

# Pinned external tools (scripts/fetch_osmnexus.sh)
.tools/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
